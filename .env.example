# Resend API key, used by src/app/api/quote/route.ts to email quote-form
# submissions to sasha.spasovski@sasakomerc.mk. Get one at https://resend.com
# after signing in, then add it here for local dev and in Vercel's project
# environment variables for production.
RESEND_API_KEY=

# Gemini API key, used by src/app/api/assistant/route.ts for the website
# assistant. Get one at https://aistudio.google.com and add it the same way.
# Leave billing off to stay on the free tier, where Google may use the messages
# to improve its products. The assistant button only appears on builds with a key.
GEMINI_API_KEY=
